# Local (npm run db:up): postgresql://postgres:postgres@localhost:5433/columbia_shine
# Producción: cadena de Supabase (Project Settings > Database > Connection string > Session pooler)
DATABASE_URL=postgresql://postgres.xxxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Texto largo y aleatorio para firmar las sesiones
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Propietario inicial: se crea solo la primera vez que arranca la app
OWNER_NAME=Juan Camilo Aguirre
OWNER_USERNAME=propietario
# Opcional: OWNER_EMAIL=propietario@columbiashine.co
OWNER_PASSWORD=una-clave-segura

# Railway define PORT automáticamente
PORT=3000
